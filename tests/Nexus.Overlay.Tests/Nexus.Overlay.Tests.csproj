<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 (no -windows suffix) so the tests run on Mac CI too.
         Only pure-logic helpers are tested; nothing here touches Win32. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Nexus.Overlay.Tests</RootNamespace>
    <AssemblyName>Nexus.Overlay.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- We pull in just the source files we need to test, rather than a
         ProjectReference to Nexus.Overlay.csproj - the overlay project is
         Windows-only and the test runner needs to load on Mac too. -->
    <Compile Include="..\..\src\RegionLayout.cs" Link="src\RegionLayout.cs" />
    <Compile Include="..\..\src\PanelGuardGeometry.cs" Link="src\PanelGuardGeometry.cs" />
    <Compile Include="..\..\src\CursorGuardGeometry.cs" Link="src\CursorGuardGeometry.cs" />
    <Compile Include="..\..\src\CursorGuardMachine.cs" Link="src\CursorGuardMachine.cs" />
    <!-- DisplayIdentity's DllImport compiles anywhere; only ExtractStableId
         (pure) is exercised here. -->
    <Compile Include="..\..\src\DisplayIdentity.cs" Link="src\DisplayIdentity.cs" />
    <Compile Include="..\..\src\MonitorKioskPlan.cs" Link="src\MonitorKioskPlan.cs" />
    <Compile Include="..\..\src\PanelHostMessage.cs" Link="src\PanelHostMessage.cs" />
    <Compile Include="..\..\src\PanelActivation.cs" Link="src\PanelActivation.cs" />
    <Compile Include="..\..\src\PanelFrost.cs" Link="src\PanelFrost.cs" />
    <Compile Include="..\..\src\PanelInputState.cs" Link="src\PanelInputState.cs" />
    <Compile Include="..\..\src\KioskPolicy.cs" Link="src\KioskPolicy.cs" />
    <Compile Include="..\..\src\MonitorMapPublisher.cs" Link="src\MonitorMapPublisher.cs" />
    <Compile Include="..\..\src\PanelKioskUrl.cs" Link="src\PanelKioskUrl.cs" />
    <Compile Include="..\..\src\LogRedact.cs" Link="src\LogRedact.cs" />
    <Compile Include="..\..\src\NexusApi.cs" Link="src\NexusApi.cs" />
    <Compile Include="..\..\src\WebViewErrorPage.cs" Link="src\WebViewErrorPage.cs" />
    <Compile Include="..\..\src\WebViewWidgetPlan.cs" Link="src\WebViewWidgetPlan.cs" />
    <Compile Include="..\..\src\Media\AnnexB.cs" Link="src\Media\AnnexB.cs" />
    <Compile Include="..\..\src\Media\SharedFrameLiveness.cs" Link="src\Media\SharedFrameLiveness.cs" />
    <Compile Include="..\..\src\Media\EncoderSelect.cs" Link="src\Media\EncoderSelect.cs" />
    <Compile Include="..\..\src\Media\FrameFraming.cs" Link="src\Media\FrameFraming.cs" />
    <Compile Include="..\..\src\Capture\StreamHostPlan.cs" Link="src\Capture\StreamHostPlan.cs" />
    <Compile Include="..\..\src\Capture\StreamWatchdogPolicy.cs" Link="src\Capture\StreamWatchdogPolicy.cs" />
    <Compile Include="..\..\src\Capture\WgcVtable.cs" Link="src\Capture\WgcVtable.cs" />
    <Compile Include="..\..\src\IdentifyBadge.cs" Link="src\IdentifyBadge.cs" />
    <Compile Include="..\..\src\ProcessTree.cs" Link="src\ProcessTree.cs" />
    <Compile Include="..\..\src\UserDataPaths.cs" Link="src\UserDataPaths.cs" />
    <Compile Include="..\..\src\Logger.cs" Link="src\Logger.cs" />
  </ItemGroup>

</Project>
